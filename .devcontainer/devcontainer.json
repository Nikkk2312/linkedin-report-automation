{
  "name": "LinkedIn Report Automation",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "postCreateCommand": "pip install --user -r requirements.txt",
  "postStartCommand": "nohup python app.py > /tmp/app.log 2>&1 &",
  "forwardPorts": [5000],
  "portsAttributes": {
    "5000": {
      "label": "LinkedIn Report Dashboard",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
