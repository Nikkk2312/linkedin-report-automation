# LinkedIn API Credentials
# Get these from https://www.linkedin.com/developers/apps
LINKEDIN_ACCESS_TOKEN=your_access_token_here
LINKEDIN_ACCOUNT_ID=your_ad_account_id
LINKEDIN_CLIENT_ID=your_client_id
LINKEDIN_CLIENT_SECRET=your_client_secret
LINKEDIN_REFRESH_TOKEN=your_refresh_token

# Multi-Account Support (comma-separated account IDs)
LINKEDIN_ACCOUNT_IDS=account_id_1,account_id_2

# n8n Configuration
N8N_ENCRYPTION_KEY=generate_a_random_32_char_key_here
N8N_PORT=5678
N8N_OWNER_EMAIL=your_email@example.com
N8N_OWNER_PASSWORD=your_secure_password

# Google OAuth (optional — for Google Sheets/Slides integration)
# Set up via: python scripts/google_auth.py
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# AI Insights (optional — Claude API for AI-powered recommendations)
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Email Delivery (optional — SMTP-based report delivery)
EMAIL_DELIVERY=false
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_RECIPIENTS=recipient1@example.com,recipient2@example.com

# Slack Notifications (optional — post report summaries to Slack)
SLACK_NOTIFICATIONS=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Webhook Configuration (optional — for external integrations)
WEBHOOK_API_KEY=your_webhook_api_key
WEBHOOK_CALLBACK_URL=https://your-app.com/webhook/callback
WEBHOOK_CALLBACK_HEADERS={"Authorization": "Bearer your_token"}

# Branding & Theming
BRAND_NAME=LinkedIn Report Automation
COMPANY_NAME=
THEME=linkedin
# Options: linkedin, dark, corporate

# Report Options
REPORT_FOOTER=Generated with LinkedIn Report Automation
PDF_EXPORT=false

# Data Storage (SQLite for historical data)
DATA_STORE_PATH=data/reports.db
REPORT_ARCHIVE_DAYS=30

# Ollama (Free Local AI)
OLLAMA_ENABLED=true
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434
AI_INSIGHTS_ENABLED=true

# OpenAI (alternative to Ollama)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
